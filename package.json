{
  "name": "autofill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autofill browser extension source rebuild",
  "scripts": {
    "build": "npm run icons && node scripts/build.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/validate-release.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run verify && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.5",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "fflate": "0.8.3",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
